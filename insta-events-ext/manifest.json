{
  "manifest_version": 3,
  "name": "GraduateNex Events Scout",
  "version": "3.0",
  "description": "Auto-scrapes Instagram for hackathons, college fests, gaming & tech events and pushes them to GraduateNex instantly.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://graduatenex.online/*",
    "https://www.graduatenex.online/*",
    "https://projectgenietechsolutions.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
