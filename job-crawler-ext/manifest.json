{
  "manifest_version": 3,
  "name": "GraduateNex Job Crawler",
  "version": "1.0",
  "description": "Auto-crawls fresh software jobs, internships & AI updates every hour and pushes to GraduateNex.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://remotive.com/*",
    "https://www.arbeitnow.com/*",
    "https://dev.to/*",
    "https://hacker-news.firebaseio.com/*",
    "https://www.graduatenex.online/*",
    "https://graduatenex.online/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}
