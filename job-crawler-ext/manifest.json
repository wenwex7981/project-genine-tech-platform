{
  "manifest_version": 3,
  "name": "GraduateNex Job Crawler",
  "version": "2.0",
  "description": "Scrapes fresh jobs from LinkedIn, Naukri, Internshala, Indeed + remote APIs. Pushes to GraduateNex hourly.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://remotive.com/*",
    "https://www.arbeitnow.com/*",
    "https://dev.to/*",
    "https://hacker-news.firebaseio.com/*",
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://internshala.com/*",
    "https://in.indeed.com/*",
    "https://www.indeed.com/*",
    "https://www.graduatenex.online/*",
    "https://graduatenex.online/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}
