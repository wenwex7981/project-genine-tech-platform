{
  "manifest_version": 3,
  "name": "GraduateNex AI Insta Suite",
  "version": "3.1",
  "description": "Auto-comment on Instagram reels + auto-post with AI captions for GraduateNex marketing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://api.openai.com/*",
    "https://*.blob.core.windows.net/*",
    "https://www.graduatenex.online/*",
    "https://graduatenex.online/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
