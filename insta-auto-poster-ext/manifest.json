{
  "manifest_version": 3,
  "name": "GraduateNex AI Insta Poster",
  "version": "2.0",
  "description": "Generate AI images and captions, and automatically post them to Instagram.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://api.openai.com/*",
    "https://*.blob.core.windows.net/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
